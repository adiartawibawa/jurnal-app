# Salin file ini menjadi `.env`, lalu isi nilainya:
#   cp .env.example .env
# JANGAN pernah commit file `.env` ke GitHub. File ini (.env.example) aman karena tanpa rahasia.

# --- Aplikasi ---
PROJECT_NAME="Jurnal App"

# Kunci rahasia untuk menandatangani token JWT. Buat dengan:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=ganti-dengan-kunci-acak-yang-panjang

# Isi "development" di komputer lokal. Kosongkan/hapus di server produksi.
FASTAPI_ENV=development

# --- PostgreSQL ---
POSTGRES_DATABASE=jurnal
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=ganti-password-anda
# ${...} diganti otomatis dari baris di atas.
# Jika password mengandung karakter khusus (@ # / :), ubah ke bentuk URL-encoded.
DATABASE_URL=postgresql://${POSTGRES_USERNAME}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DATABASE}

# --- Opsional: masa berlaku token (dalam menit) ---
# ACCESS_TOKEN_EXPIRE_MINUTES=11520
# RESET_TOKEN_EXPIRE_MINUTES=15

# --- Opsional: reset password lewat email ---
# Alamat frontend yang dipakai pada tautan di email reset password
# FRONTEND_URL=http://localhost:3000
# Selama SMTP_HOST kosong dan FASTAPI_ENV=development, isi email dicetak di terminal.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=emailanda@gmail.com
# SMTP_PASSWORD=app-password-anda
# SMTP_TLS=True
# EMAILS_FROM_EMAIL=emailanda@gmail.com
